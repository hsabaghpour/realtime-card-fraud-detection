# Copy to .env to override defaults. Nothing here is required for `make demo`.

# Which configs/<env>.yaml to layer on top of base.yaml (local | databricks)
SENTINELPAY_ENV=local

# Number of history-period transactions to generate (default 500000)
# SAMPLE_SIZE=500000

# Random seed for deterministic data generation
# SEED=42

# Override output locations
# SENTINELPAY_DATA_ROOT=data
# SENTINELPAY_REPORTS_DIR=reports

# Spark 4 needs Java 17 or 21. Auto-detected by scripts/find_java.sh if unset.
# JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
